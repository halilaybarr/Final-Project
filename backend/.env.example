# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
# For local development, use: mongodb://localhost:27017/news-explorer
# For production, use MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/news-explorer

# JWT Secret
# IMPORTANT: Change this to a random, secure string in production
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Settings (Optional)
# For production, set this to your frontend URL
# ALLOWED_ORIGINS=https://yourfrontend.com
